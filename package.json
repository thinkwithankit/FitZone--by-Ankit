{
  "name": "fitzone-fullstack-gym",
  "version": "1.0.0",
  "description": "FitZone - Full Stack Gym & Fitness Web Application with React, Tailwind CSS, Node.js & MySQL",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "cd server && npm start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
